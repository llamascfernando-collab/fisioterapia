<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fisioterapia MVP Rehab Center</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f1f8fb;
  --card: #ffffff;
  --ink: #0b2236;
  --muted: #526b7d;
  --blue: #1f6bff;
  --aqua: #cfeaf3;
  --navy: #08203a;
  --line: #dcebf1;
  --warm: #ff7a59;
  --display: "Bricolage Grotesque", "Trebuchet MS", sans-serif;
  --body: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
  color-scheme: light;
}
* { box-sizing: border-box; margin: 0; }
html { scroll-behavior: smooth; }
body { background: var(--bg); color: var(--ink); font-family: var(--body); font-size: 17px; line-height: 1.6; }
a { color: inherit; }
:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; border-radius: 4px; }
.wrap { width: min(1080px, 100% - 32px); margin-inline: auto; }
h1, h2, h3 { font-family: var(--display); font-weight: 800; line-height: 1.1; text-wrap: balance; letter-spacing: -.01em; }
h2 { font-size: clamp(1.9rem, 4vw, 2.7rem); }
h3 { font-size: 1.15rem; font-weight: 600; }
p { max-width: 65ch; }
.tag { display: inline-block; font-family: var(--body); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); background: #e3eff4; border-radius: 20px; padding: 2px 10px; margin-left: 10px; vertical-align: middle; font-weight: 700; }

.proto { background: var(--navy); color: #b9cde0; font-size: .85rem; text-align: center; padding: 8px 16px; }
.proto b { color: #fff; font-weight: 700; }
.proto .tag { margin: 0 2px; background: #17375a; color: #cfe3f5; }

header.nav { position: sticky; top: 0; z-index: 5; background: rgba(241,248,251,.93); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
.nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding-block: 10px; flex-wrap: wrap; }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--display); font-weight: 800; font-size: 1.1rem; }
.brand img { width: 44px; height: 44px; border-radius: 50%; }
.nav nav { display: flex; gap: 20px; flex-wrap: wrap; font-size: .95rem; font-weight: 500; }
.nav nav a { text-decoration: none; color: var(--muted); }
.nav nav a:hover { color: var(--blue); }

.btn { display: inline-block; background: var(--blue); color: #fff; text-decoration: none; font-weight: 700; padding: 14px 26px; border-radius: 40px; box-shadow: 0 6px 18px rgba(31,107,255,.28); }
.btn:hover { background: #1456d6; }
.btn.light { background: #fff; color: var(--ink); box-shadow: none; border: 1px solid var(--line); }
.btn.light:hover { background: var(--aqua); }

.hero { padding: 56px 0 72px; }
.hero .wrap { display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: center; }
.eyebrow { color: var(--blue); font-weight: 700; font-size: .9rem; margin-bottom: 12px; }
.hero h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); margin-bottom: 18px; }
.hero h1 span { color: var(--blue); }
.hero p.lead { color: var(--muted); font-size: 1.12rem; margin-bottom: 26px; }
.cta { display: flex; gap: 12px; flex-wrap: wrap; }
.facts { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 30px; color: var(--muted); font-size: .92rem; }
.facts b { display: block; color: var(--ink); font-family: var(--display); font-size: 1.3rem; }

.art { position: relative; aspect-ratio: 1 / 1.02; width: 100%; max-width: 440px; justify-self: center; }
.art .blob { position: absolute; inset: 0; width: 100%; height: 100%; }
.art .logo { position: absolute; width: 46%; left: 27%; top: 12%; border-radius: 50%; box-shadow: 0 14px 40px rgba(8,32,58,.28); }
.art .spine { position: absolute; width: 22%; right: 6%; bottom: 6%; filter: drop-shadow(0 8px 14px rgba(8,32,58,.15)); }
.art .chip { position: absolute; background: #fff; border-radius: 14px; padding: 10px 14px; font-size: .85rem; font-weight: 700; box-shadow: 0 8px 22px rgba(8,32,58,.12); display: flex; align-items: center; gap: 8px; }
.art .chip i { width: 10px; height: 10px; border-radius: 50%; background: var(--warm); display: inline-block; }
.art .chip.a { left: 0; bottom: 22%; }
.art .chip.b { right: 0; top: 6%; }
.art .chip.b i { background: #2bbf8e; }

section { padding: 72px 0; }
.head { margin-bottom: 34px; display: flex; flex-direction: column; gap: 10px; }
.head p { color: var(--muted); }

.prices { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 18px; }
.price { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 26px; display: flex; flex-direction: column; gap: 6px; }
.price .kind { font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--blue); }
.price .amt { font-family: var(--display); font-weight: 800; font-size: 2.4rem; margin-top: auto; padding-top: 14px; font-variant-numeric: tabular-nums; }
.price .amt small { font-size: .9rem; color: var(--muted); font-weight: 600; margin-left: 4px; }
.price p { color: var(--muted); font-size: .94rem; }
.price.feat { background: var(--blue); border-color: var(--blue); color: #fff; }
.price.feat .kind, .price.feat p, .price.feat .amt small { color: #dbe7ff; }

.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 18px; }
.tcard { background: var(--card); border-radius: 22px; padding: 24px; border: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; }
.tcard .ico { width: 54px; height: 54px; border-radius: 16px; background: var(--aqua); display: grid; place-items: center; }
.tcard .ico svg { width: 30px; height: 30px; stroke: var(--navy); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.tcard p { color: var(--muted); font-size: .95rem; }

.steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; counter-reset: s; }
.step { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 24px; }
.step::before { counter-increment: s; content: counter(s); width: 38px; height: 38px; border-radius: 50%; background: var(--navy); color: #fff; display: grid; place-items: center; font-family: var(--display); font-weight: 800; margin-bottom: 14px; }
.step p { color: var(--muted); font-size: .94rem; margin-top: 6px; }

.two { display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; align-items: start; }
.hours { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 8px 24px; }
.hours div { display: flex; justify-content: space-between; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); font-variant-numeric: tabular-nums; }
.hours div:last-child { border-bottom: 0; }
.hours span:last-child { color: var(--muted); }
details { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 16px 20px; margin-bottom: 10px; }
summary { cursor: pointer; font-weight: 700; list-style: none; display: flex; justify-content: space-between; gap: 14px; }
summary::after { content: "+"; color: var(--blue); font-size: 1.4rem; line-height: 1; }
details[open] summary::after { content: "–"; }
details p { color: var(--muted); margin-top: 8px; font-size: .95rem; }

.contact-band { background: var(--navy); color: #fff; border-radius: 32px; padding: 48px 32px; margin-bottom: 56px; }
.contact-band h2 { margin-bottom: 26px; }
.contact { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
.contact .box { background: #0e2c4d; border-radius: 18px; padding: 20px; }
.contact .label { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: #8fb6e8; font-weight: 700; margin-bottom: 6px; }
.contact .big { font-family: var(--display); font-weight: 800; font-size: 1.6rem; font-variant-numeric: tabular-nums; }
.contact p, .contact a { word-break: break-word; }
.contact-band .cta { margin-top: 28px; }

footer { padding: 0 0 40px; color: var(--muted); font-size: .88rem; }
footer .wrap { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

/* Mapa del cuerpo */
.map { background: var(--card); border-block: 1px solid var(--line); padding: 64px 0; }
.map-grid { display: grid; grid-template-columns: minmax(260px, 340px) 1fr; gap: 40px; align-items: start; }
.tabs { display: inline-flex; background: var(--bg); border-radius: 40px; padding: 4px; gap: 4px; margin-bottom: 14px; }
.tabs button { border: 0; background: transparent; font: inherit; font-weight: 700; padding: 9px 22px; border-radius: 30px; cursor: pointer; color: var(--muted); }
.tabs button[aria-pressed="true"] { background: var(--navy); color: #fff; }
.bodybox { background: var(--bg); border-radius: 28px; padding: 18px 14px 14px; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.bodybox svg { width: 100%; max-width: 280px; height: auto; display: block; }
.bodybox .hint { color: var(--muted); font-size: .88rem; text-align: center; }
.zone { fill: rgba(31,107,255,.12); stroke: rgba(31,107,255,.4); stroke-width: 1; stroke-dasharray: 3 2; cursor: pointer; transition: fill .15s; }
.zone:hover { fill: rgba(31,107,255,.35); }
.zone:focus-visible { outline: none; stroke: var(--navy); stroke-width: 2.5; stroke-dasharray: none; }
.zone.on { fill: rgba(255,122,89,.82); stroke: #fff; stroke-width: 2; stroke-dasharray: none; }
.side { font: 700 9px var(--body); fill: var(--muted); letter-spacing: .08em; }
.panel { display: flex; flex-direction: column; gap: 18px; }
.panel h3 { font-size: 1.05rem; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; min-height: 36px; }
.chip-s { display: inline-flex; align-items: center; gap: 6px; background: #ffe9e2; color: #8a2f14; border-radius: 30px; padding: 6px 8px 6px 14px; font-weight: 700; font-size: .9rem; }
.chip-s button { border: 0; background: #fff; color: #8a2f14; width: 22px; height: 22px; border-radius: 50%; cursor: pointer; font-size: .85rem; line-height: 1; }
.empty { color: var(--muted); font-size: .95rem; }
.causes { display: grid; gap: 10px; }
.cause { background: var(--bg); border-radius: 16px; padding: 14px 18px; }
.cause b { display: block; margin-bottom: 4px; }
.cause ul { margin: 0; padding-left: 18px; color: var(--muted); font-size: .93rem; }
.cause .more { margin-top: 6px; font-size: .88rem; color: var(--ink); }
.fields { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.fields label { display: flex; flex-direction: column; gap: 6px; font-weight: 700; font-size: .9rem; }
.fields .full { grid-column: 1 / -1; }
.fields select, .fields textarea { font: inherit; font-weight: 400; padding: 10px 12px; border: 1px solid var(--line); border-radius: 12px; background: #fff; color: var(--ink); }
.fields textarea { resize: vertical; min-height: 64px; }
.fields input[type=range] { accent-color: var(--blue); width: 100%; }
.fields output { color: var(--blue); font-family: var(--display); font-weight: 800; }
.note { background: #fff6e8; border: 1px solid #f6dcaa; color: #6b4a10; border-radius: 14px; padding: 12px 16px; font-size: .88rem; }
.panel .cta button.btn { border: 1px solid var(--line); cursor: pointer; font: inherit; font-weight: 700; }

@media (max-width: 780px) {
  .hero .wrap, .two, .map-grid, .fields { grid-template-columns: 1fr; }
  .art { max-width: 340px; }
  section { padding: 52px 0; }
  .map { padding: 48px 0; }
  .contact-band { padding: 36px 20px; border-radius: 24px; }
  .nav nav { gap: 14px; font-size: .88rem; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
</head>
<body>

<div class="proto"><b>Prototipo.</b> Precios, dirección y contacto son reales. Lo marcado <span class="tag">ejemplo</span> es texto inventado.</div>

<header class="nav">
  <div class="wrap">
    <a class="brand" href="#inicio"><img src="logo.png" alt="Logo de Fisioterapia"><span>MVP Rehab Center</span></a>
    <nav aria-label="Principal">
      <a href="#servicios">Servicios</a>
      <a href="#tratamientos">Tratamientos</a>
      <a href="#dolor">¿Dónde te duele?</a>
      <a href="#preguntas">Preguntas</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </div>
</header>

<main>
<section class="hero" id="inicio">
  <div class="wrap">
    <div>
      <p class="eyebrow">Fisioterapia en Tijuana</p>
      <h1>Menos dolor, <span>más movimiento.</span></h1>
      <p class="lead">Te evaluamos, te tratamos y te damos seguimiento con fisioterapeutas y médico en el mismo lugar.</p>
      <div class="cta">
        <a class="btn" href="https://wa.me/526641132878" target="_blank" rel="noopener">Agendar por WhatsApp</a>
        <a class="btn light" href="#dolor">¿Dónde te duele?</a>
      </div>
      <div class="facts">
        <div><b>$800</b>consulta general</div>
        <div><b>664 113 2878</b>WhatsApp</div>
      </div>
    </div>

    <div class="art">
      <svg class="blob" viewBox="0 0 400 408" role="img" aria-label="Fondo decorativo">
        <path d="M60 90 C 90 10, 250 -20, 330 60 C 410 140, 400 280, 330 340 C 250 410, 100 400, 45 310 C -10 230, 20 150, 60 90 Z" fill="#cfeaf3"/>
        <circle cx="352" cy="300" r="26" fill="#ffffff" opacity=".7"/>
        <circle cx="40" cy="60" r="14" fill="#ffffff" opacity=".8"/>
        <circle cx="70" cy="350" r="9" fill="#1f6bff" opacity=".25"/>
      </svg>
      <img class="logo" src="logo.png" alt="Logo de Fisioterapia: figura azul en movimiento dentro de un círculo">
      <svg class="spine" viewBox="0 0 120 320" role="img" aria-label="Ilustración de columna vertebral">
        <defs><linearGradient id="v" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7fb2ff"/><stop offset="1" stop-color="#1f6bff"/></linearGradient></defs>
        <rect x="40" y="8" width="40" height="24" rx="10" fill="url(#v)"/>
        <rect x="45.7" y="42" width="44" height="24" rx="10" fill="url(#v)"/>
        <rect x="46.8" y="76" width="50" height="24" rx="11" fill="url(#v)"/>
        <rect x="42.4" y="110" width="56" height="24" rx="11" fill="url(#v)"/>
        <rect x="34" y="144" width="60" height="24" rx="12" fill="url(#v)"/>
        <rect x="24.8" y="178" width="62" height="24" rx="12" fill="url(#v)"/>
        <rect x="17.5" y="212" width="64" height="24" rx="12" fill="url(#v)"/>
        <rect x="17.2" y="246" width="62" height="24" rx="12" fill="url(#v)"/>
        <rect x="23.4" y="280" width="58" height="24" rx="12" fill="url(#v)"/>
      </svg>
      <div class="chip a"><i></i>Zona lumbar</div>
      <div class="chip b"><i></i>Plan a tu medida</div>
    </div>
  </div>
</section>

<section class="map" id="dolor">
  <div class="wrap">
    <div class="head">
      <h2>¿Dónde te duele?</h2>
      <p>Toca las zonas del cuerpo donde sientes molestia. Te damos una idea aproximada de qué podría ser y puedes mandar todo por WhatsApp.</p>
    </div>
    <div class="map-grid">
      <div>
        <div class="tabs" role="group" aria-label="Vista del cuerpo">
          <button type="button" id="tab-front" aria-pressed="true">De frente</button>
          <button type="button" id="tab-back" aria-pressed="false">De espalda</button>
        </div>
        <div class="bodybox">
          <svg id="body" viewBox="0 0 200 400" role="group" aria-label="Mapa del cuerpo humano"></svg>
          <p class="hint">Puedes elegir varias zonas. Cambia a la vista de espalda para ver la otra parte.</p>
        </div>
      </div>
      <div class="panel">
        <div>
          <h3>Zonas seleccionadas</h3>
          <div class="chips" id="chips" aria-live="polite"></div>
        </div>
        <div>
          <h3>Qué podría ser (aproximado)</h3>
          <div class="causes" id="causes" aria-live="polite" style="margin-top:10px"></div>
        </div>
        <div class="fields">
          <label class="full" for="int"><span>Intensidad del dolor: <output id="intOut">5</output> de 10</span>
            <input type="range" id="int" min="1" max="10" value="5">
          </label>
          <label for="since">Desde cuándo
            <select id="since">
              <option value="">Sin indicar</option>
              <option>Hoy o menos de una semana</option>
              <option>De 1 a 4 semanas</option>
              <option>De 1 a 3 meses</option>
              <option>Más de 3 meses</option>
            </select>
          </label>
          <label for="notes">Algo más que quieras contarnos
            <textarea id="notes" placeholder="Por ejemplo: me duele más al levantarme"></textarea>
          </label>
        </div>
        <p class="note"><b>Es solo una orientación, no un diagnóstico.</b> El fisioterapeuta lo confirma en tu valoración. Si tienes dolor fuerte en el pecho con falta de aire, desmayo, o pierdes fuerza o sensibilidad de repente, acude a urgencias.</p>
        <div class="cta">
          <a class="btn" id="wa" href="#" target="_blank" rel="noopener">Enviar por WhatsApp</a>
          <button type="button" class="btn light" id="clear">Limpiar</button>
        </div>
      </div>
    </div>
  </div>
  <script>
  (function () {
    var PHONE = "526641132878";
    var CAUSES = {
      head: ["Tensión muscular en cuello y cráneo", "Dolor de cabeza tensional por estrés o postura", "Contractura de la base del cráneo"],
      neck: ["Contractura cervical", "Mala postura (celular, computadora)", "Tortícolis o sobrecarga al dormir"],
      shoulder: ["Tendinitis del hombro", "Contractura del trapecio", "Bursitis o pinzamiento al levantar el brazo"],
      trap: ["Contractura del trapecio por estrés o postura", "Sobrecarga al cargar peso", "Tensión cervical que baja al hombro"],
      chest: ["Tensión de músculos del pecho o de las costillas", "Inflamación del cartílago costal", "Postura encorvada"],
      abdomen: ["Tensión de la musculatura abdominal", "Debilidad del core con sobrecarga lumbar"],
      elbow: ["Epicondilitis (inflamación de tendones del codo)", "Bursitis", "Sobrecarga por movimientos repetidos"],
      hand: ["Síndrome del túnel del carpo", "Tendinitis de muñeca", "Esguince leve"],
      hip: ["Bursitis de la cadera", "Tensión del psoas", "Desgaste de la articulación"],
      thigh: ["Contractura muscular", "Distensión o desgarre leve", "Tensión del cuádriceps"],
      knee: ["Desgaste del cartílago", "Tendinitis rotuliana", "Lesión de menisco o ligamentos"],
      shin: ["Sobrecarga de la espinilla (periostitis)", "Fatiga muscular", "Tensión en la parte frontal de la pierna"],
      ankle: ["Esguince de tobillo", "Fascitis plantar", "Tendinitis"],
      upperback: ["Contractura entre los omóplatos", "Mala postura sentado", "Tensión por cargar peso"],
      midback: ["Contractura dorsal", "Postura prolongada frente al escritorio", "Tensión de costillas y músculos de la espalda"],
      lumbar: ["Lumbalgia por contractura", "Sobrecarga o mala mecánica al cargar", "Si baja por la pierna, podría ser ciática o hernia de disco"],
      glute: ["Síndrome del piriforme", "Ciática", "Tensión del glúteo medio"],
      ham: ["Tensión o distensión de los isquiotibiales", "Contractura", "Dolor referido desde la zona lumbar"],
      kneeback: ["Tendinitis detrás de la rodilla", "Quiste de Baker", "Tensión de isquiotibiales o pantorrilla"],
      calf: ["Contractura o calambres", "Sobrecarga de pantorrilla", "Tensión del tendón de Aquiles"],
      heel: ["Tendinitis de Aquiles", "Fascitis plantar", "Esguince o sobrecarga del tobillo"]
    };
    var EXTRA = { abdomen: "El dolor abdominal también puede venir de órganos internos. El médico del centro puede revisarlo.", chest: "Si el dolor es fuerte, va con falta de aire, sudor o mareo, acude a urgencias." };
    // [id, etiqueta, tipo, cx, cy, rx, ry]
    var Z = {
      front: [
        ["f-cabeza","Cabeza","head",100,34,22,22], ["f-cuello","Cuello","neck",100,66,12,9],
        ["f-hom-d","Hombro derecho","shoulder",68,88,13,12], ["f-hom-i","Hombro izquierdo","shoulder",132,88,13,12],
        ["f-pecho","Pecho","chest",100,112,24,17], ["f-abdomen","Abdomen","abdomen",100,152,22,20],
        ["f-codo-d","Codo derecho","elbow",50,150,11,12], ["f-codo-i","Codo izquierdo","elbow",150,150,11,12],
        ["f-mano-d","Muñeca y mano derecha","hand",45,214,12,16], ["f-mano-i","Muñeca y mano izquierda","hand",155,214,12,16],
        ["f-cad-d","Cadera derecha","hip",82,200,14,12], ["f-cad-i","Cadera izquierda","hip",118,200,14,12],
        ["f-mus-d","Muslo derecho","thigh",84,240,14,22], ["f-mus-i","Muslo izquierdo","thigh",116,240,14,22],
        ["f-rod-d","Rodilla derecha","knee",84,280,14,13], ["f-rod-i","Rodilla izquierda","knee",116,280,14,13],
        ["f-pie-d","Espinilla derecha","shin",84,322,12,24], ["f-pie-i","Espinilla izquierda","shin",116,322,12,24],
        ["f-tob-d","Tobillo y pie derecho","ankle",84,368,14,16], ["f-tob-i","Tobillo y pie izquierdo","ankle",116,368,14,16]
      ],
      back: [
        ["b-cabeza","Parte trasera de la cabeza","head",100,34,22,22], ["b-nuca","Cuello (nuca)","neck",100,66,12,9],
        ["b-trap-i","Hombro y trapecio izquierdo","trap",68,86,15,11], ["b-trap-d","Hombro y trapecio derecho","trap",132,86,15,11],
        ["b-alta","Espalda alta","upperback",100,108,22,16], ["b-media","Espalda media","midback",100,142,22,16],
        ["b-lumbar","Zona lumbar","lumbar",100,176,22,14],
        ["b-codo-i","Codo izquierdo","elbow",50,150,11,12], ["b-codo-d","Codo derecho","elbow",150,150,11,12],
        ["b-mano-i","Muñeca y mano izquierda","hand",45,214,12,16], ["b-mano-d","Muñeca y mano derecha","hand",155,214,12,16],
        ["b-glut-i","Glúteo izquierdo","glute",84,206,15,13], ["b-glut-d","Glúteo derecho","glute",116,206,15,13],
        ["b-mus-i","Parte trasera del muslo izquierdo","ham",84,246,14,20], ["b-mus-d","Parte trasera del muslo derecho","ham",116,246,14,20],
        ["b-rod-i","Detrás de la rodilla izquierda","kneeback",84,282,13,11], ["b-rod-d","Detrás de la rodilla derecha","kneeback",116,282,13,11],
        ["b-pant-i","Pantorrilla izquierda","calf",84,322,12,24], ["b-pant-d","Pantorrilla derecha","calf",116,322,12,24],
        ["b-tal-i","Talón y tobillo izquierdo","heel",84,368,14,16], ["b-tal-d","Talón y tobillo derecho","heel",116,368,14,16]
      ]
    };
    var NS = "http://www.w3.org/2000/svg";
    var svg = document.getElementById("body");
    var view = "front";
    var sel = {};
    var order = [];

    function el(name, attrs) { var e = document.createElementNS(NS, name); for (var k in attrs) e.setAttribute(k, attrs[k]); return e; }

    function drawBase() {
      var g = el("g", { stroke: "#cfeaf3", "stroke-width": "22", "stroke-linecap": "round", "stroke-linejoin": "round", fill: "none" });
      g.appendChild(el("path", { d: "M100 58v14", "stroke-width": "14" }));
      g.appendChild(el("path", { d: "M68 82 Q100 70 132 82 L128 190 Q100 200 72 190 Z", fill: "#cfeaf3", "stroke-width": "6" }));
      g.appendChild(el("path", { d: "M66 86 50 150 45 208", "stroke-width": "18" }));
      g.appendChild(el("path", { d: "M134 86 150 150 155 208", "stroke-width": "18" }));
      g.appendChild(el("path", { d: "M84 198 84 280 84 362", "stroke-width": "26" }));
      g.appendChild(el("path", { d: "M116 198 116 280 116 362", "stroke-width": "26" }));
      var head = el("circle", { cx: 100, cy: 34, r: 22, fill: "#cfeaf3", stroke: "none" });
      var hl = el("ellipse", { cx: 45, cy: 218, rx: 10, ry: 14, fill: "#cfeaf3", stroke: "none" });
      var hr = el("ellipse", { cx: 155, cy: 218, rx: 10, ry: 14, fill: "#cfeaf3", stroke: "none" });
      var fl = el("ellipse", { cx: 84, cy: 376, rx: 15, ry: 9, fill: "#cfeaf3", stroke: "none" });
      var fr = el("ellipse", { cx: 116, cy: 376, rx: 15, ry: 9, fill: "#cfeaf3", stroke: "none" });
      [g, head, hl, hr, fl, fr].forEach(function (n) { svg.appendChild(n); });
      var a = el("text", { "class": "side", x: 6, y: 14 }); a.setAttribute("id", "sideL");
      var b = el("text", { "class": "side", x: 194, y: 14, "text-anchor": "end" }); b.setAttribute("id", "sideR");
      svg.appendChild(a); svg.appendChild(b);
    }

    function drawZones() {
      Array.prototype.slice.call(svg.querySelectorAll(".zone")).forEach(function (n) { n.remove(); });
      Z[view].forEach(function (z) {
        var e = el("ellipse", { "class": "zone" + (sel[z[0]] ? " on" : ""), cx: z[3], cy: z[4], rx: z[5], ry: z[6], tabindex: 0, role: "button", "aria-pressed": sel[z[0]] ? "true" : "false", "aria-label": z[1] });
        var t = el("title", {}); t.textContent = z[1]; e.appendChild(t);
        var toggle = function () { toggleZone(z); };
        e.addEventListener("click", toggle);
        e.addEventListener("keydown", function (ev) { if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); toggle(); } });
        svg.appendChild(e);
      });
      // De frente, la derecha de la persona queda a la izquierda de la pantalla
      document.getElementById("sideL").textContent = view === "front" ? "DERECHA" : "IZQUIERDA";
      document.getElementById("sideR").textContent = view === "front" ? "IZQUIERDA" : "DERECHA";
    }

    function toggleZone(z) {
      if (sel[z[0]]) { delete sel[z[0]]; order = order.filter(function (i) { return i !== z[0]; }); }
      else { sel[z[0]] = { label: z[1], type: z[2], view: z[0].charAt(0) === "f" ? "frente" : "espalda" }; order.push(z[0]); }
      refresh();
    }

    function refresh() {
      drawZones();
      var chips = document.getElementById("chips"), causes = document.getElementById("causes");
      chips.innerHTML = ""; causes.innerHTML = "";
      if (!order.length) {
        chips.innerHTML = '<span class="empty">Aún no marcas ninguna zona. Toca el cuerpo donde te duele.</span>';
        causes.innerHTML = '<span class="empty">Aquí aparecerán las posibles causas de las zonas que elijas.</span>';
      }
      order.forEach(function (id) {
        var s = sel[id];
        var c = document.createElement("span"); c.className = "chip-s";
        c.appendChild(document.createTextNode(s.label + (s.view === "espalda" ? " (espalda)" : "")));
        var x = document.createElement("button"); x.type = "button"; x.textContent = "✕"; x.setAttribute("aria-label", "Quitar " + s.label);
        x.addEventListener("click", function () { delete sel[id]; order = order.filter(function (i) { return i !== id; }); refresh(); });
        c.appendChild(x); chips.appendChild(c);
        var card = document.createElement("div"); card.className = "cause";
        var h = document.createElement("b"); h.textContent = s.label; card.appendChild(h);
        var ul = document.createElement("ul");
        CAUSES[s.type].forEach(function (t) { var li = document.createElement("li"); li.textContent = t; ul.appendChild(li); });
        card.appendChild(ul);
        if (EXTRA[s.type]) { var p = document.createElement("p"); p.className = "more"; p.textContent = EXTRA[s.type]; card.appendChild(p); }
        causes.appendChild(card);
      });
      updateWa();
    }

    function updateWa() {
      var lines = ["Hola, quiero agendar una consulta de fisioterapia."];
      if (order.length) {
        lines.push("", "Me duele:");
        order.forEach(function (id) { var s = sel[id]; lines.push("• " + s.label + " (" + s.view + ")"); });
        lines.push("", "Intensidad: " + document.getElementById("int").value + "/10");
        var since = document.getElementById("since").value; if (since) lines.push("Desde cuándo: " + since);
        var notes = document.getElementById("notes").value.trim(); if (notes) lines.push("Comentarios: " + notes);
      }
      document.getElementById("wa").href = "https://wa.me/" + PHONE + "?text=" + encodeURIComponent(lines.join("\n"));
    }

    function setView(v) {
      view = v;
      document.getElementById("tab-front").setAttribute("aria-pressed", v === "front");
      document.getElementById("tab-back").setAttribute("aria-pressed", v === "back");
      drawZones();
    }

    document.getElementById("tab-front").addEventListener("click", function () { setView("front"); });
    document.getElementById("tab-back").addEventListener("click", function () { setView("back"); });
    document.getElementById("int").addEventListener("input", function (e) { document.getElementById("intOut").textContent = e.target.value; updateWa(); });
    document.getElementById("since").addEventListener("change", updateWa);
    document.getElementById("notes").addEventListener("input", updateWa);
    document.getElementById("clear").addEventListener("click", function () { sel = {}; order = []; refresh(); });

    drawBase();
    refresh();
  })();
  </script>
</section>

